// Every directory this program could read a configuration file from,
// user first, then site — each with the project path joined on.
//
// The list config-nv's `cfgstack.with_files` takes.
//
// ```novo
// use dfapp
// use dfenv
//
// fn main() [io]
//     for d in dfapp.config_search_path(dfenv.capture(), dfapp.app("novo"))
//         println(d)
// ```
pub fn config_search_path(e: dfenv.DfEnv, a: DfApp) -> [Str] []
    todo("datafile-nv.dfapp.config_search_path")

// Every file named `file_name` this program could read a configuration
// from, in precedence order, highest first.
//
// The one call a layered configuration reader makes: it hands the
// result straight to `cfgstack.with_files` with the list reversed, and
// the platform precedence is decided here rather than guessed there.
//
// ```novo
// use dfapp
// use dfenv
//
// fn main() [io]
//     for p in dfapp.config_file_candidates(dfenv.capture(), dfapp.app("novo"), "config.toml")
//         println(p)
// ```
pub fn config_file_candidates(e: dfenv.DfEnv, a: DfApp, file_name: Str) -> [Str] []
    todo("datafile-nv.dfapp.config_file_candidates")
