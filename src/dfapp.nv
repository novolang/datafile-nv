// A named file inside this program's directory for a role.
//
// `file_name` is sanitised as a single component the same way the
// project path is, so `config_file(e, a, DfConfig, "../../.ssh/id_rsa")`
// cannot reach outside the program's own directory.
//
// ```novo
// use dfapp
// use dfenv
//
// fn main() [io]
//     println(dfapp.app_file(dfenv.capture(), dfapp.app("novo"), DfConfig, "novo.toml"))
// ```
pub fn app_file(e: dfenv.DfEnv, a: DfApp, r: dfplat.DfRole, file_name: Str) -> Str []
    todo("datafile-nv.dfapp.app_file")

