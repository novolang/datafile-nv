// dfuser.nv — Documents, Downloads, Pictures: the directories that
// belong to the PERSON rather than to the program.
//
// THIS IS THE ONE PLACE IN THE PACKAGE THAT READS A FILE.  On Linux
// the user directories are not in the environment: they are in
// `$XDG_CONFIG_HOME/user-dirs.dirs`, a shell-shaped file
// `xdg-user-dirs` writes, and a library that skipped it answers
// `~/Documents` to somebody whose desktop environment is in French and
// whose directory is `~/Documents` only by coincidence.
//
// So `user_dir` is `[fs]` — and the parse is `[]`, in
// `parse_user_dirs`, which is what makes the file's real quirks
// testable from a string:
//
//   `XDG_DOCUMENTS_DIR="$HOME/Documents"`  — the value is quoted, and
//                                            `$HOME` is expanded
//   `XDG_DESKTOP_DIR="$HOME/"`             — a trailing separator
//   `XDG_DOWNLOAD_DIR="/mnt/big/dl"`       — absolute, no `$HOME`
//   `# comment lines and blanks`
//
// `$HOME` is the ONLY expansion.  The file is written by a program and
// read by programs; treating it as shell would mean a command
// substitution in a configuration file turning into a command, which
// is a hole nobody needs. A `$` followed by anything else is left
// alone.
//
// MACOS AND WINDOWS DO NOT NEED THE FILE.  macOS names these
// directories in English under `~` and does not localise the path.
// Windows stores them in the registry, which this package does not
// read — so the Windows column answers the default under
// `%USERPROFILE%` and `default_user_dir` is the honest name for what
// it is doing.  A row for the registry is named in the README as
// missing rather than guessed at.
//
// FONTS ARE A LIST.  Every other role has one directory; fonts have
// two on Linux (`~/.local/share/fonts` and `~/.fonts`) and two on
// macOS (`~/Library/Fonts` and `/Library/Fonts`).  `font_dirs`
// answers all of them in precedence order and `user_dir(e, DfFonts)`
// answers the first, so a caller enumerating a person's fonts gets
// the whole set and one asking where to install gets one path.

use dfbase
use dfenv
use dfplat

// A directory that belongs to the person using the machine.
//
// ```novo
// use dfuser
//
// fn main() [io]
//     println(dfuser.user_dir_name(DfDocuments))
// ```
pub enum DfUserDir
    // The desktop, where it exists.
    DfDesktop
    // Documents.
    DfDocuments
    // Downloads.
    DfDownload
    // Music.
    DfMusic
    // Pictures.
    DfPictures
    // Videos.
    DfVideos
    // The directory shared with other users of the machine.
    DfPublicShare
    // Document templates.
    DfTemplates
    // Fonts installed for this user.  See `font_dirs`.
    DfFonts

// The lower-case name of a user directory: `desktop`, `documents`,
// `download`, and so on.
//
// ```novo
// use dfuser
//
// fn main() [io]
//     println(dfuser.user_dir_name(DfPublicShare))
// ```
pub fn user_dir_name(d: DfUserDir) -> Str []
    match d
        DfDesktop     => "desktop"
        DfDocuments   => "documents"
        DfDownload    => "download"
        DfMusic       => "music"
        DfPictures    => "pictures"
        DfVideos      => "videos"
        DfPublicShare => "public-share"
        DfTemplates   => "templates"
        DfFonts       => "fonts"

// Every user directory, in a stable order.
//
// ```novo
// use dfuser
//
// fn main() [io]
//     println("${dfuser.user_dirs().len()}")
// ```
pub fn user_dirs() -> [DfUserDir] []
    [DfDesktop, DfDocuments, DfDownload, DfMusic, DfPictures, DfVideos,
     DfPublicShare, DfTemplates, DfFonts]

// The key `user-dirs.dirs` writes for a directory:
// `XDG_DOCUMENTS_DIR`, `XDG_DOWNLOAD_DIR`, and so on.
//
// `""` for `DfFonts`, which the file does not carry.
//
// ```novo
// use dfuser
//
// fn main() [io]
//     println(dfuser.xdg_key(DfDownload))
// ```
pub fn xdg_key(d: DfUserDir) -> Str []
    match d
        DfDesktop     => "XDG_DESKTOP_DIR"
        DfDocuments   => "XDG_DOCUMENTS_DIR"
        DfDownload    => "XDG_DOWNLOAD_DIR"
        DfMusic       => "XDG_MUSIC_DIR"
        DfPictures    => "XDG_PICTURES_DIR"
        DfVideos      => "XDG_VIDEOS_DIR"
        DfPublicShare => "XDG_PUBLICSHARE_DIR"
        DfTemplates   => "XDG_TEMPLATES_DIR"
        DfFonts       => ""

// Where `user-dirs.dirs` lives in this environment:
// `<config>/user-dirs.dirs`, or `""` off Linux.
//
// ```novo
// use dfuser
// use dfenv
//
// fn main() [io]
//     println(dfuser.user_dirs_path(dfenv.capture()))
// ```
pub fn user_dirs_path(e: dfenv.DfEnv) -> Str []
    if dfenv.platform(e) != DfLinux
        return ""
    let base = dfbase.config_dir(e)
    if base == ""
        return ""
    dfplat.join(DfLinux, base, "user-dirs.dirs")

// A value with `$HOME` in it replaced by the home directory.
//
// Only that one name is substituted, and only when there is a home to
// substitute: a `$` in front of anything else is left as the file
// wrote it, because running it through a shell is the hole this
// refuses to open.
fn expand_home(value: Str, home: Str) -> Str
    if home == ""
        return value
    str.replace(value, "\$HOME", home)

// A value with one trailing separator removed.
//
// `xdg-user-dirs` writes `"$HOME/"` for a person whose desktop is the
// home directory itself, and the join onto it would double it.
fn without_trailing(value: Str) -> Str
    let n = str.len(value)
    if n > 1
        let ch = str.byte_at_or(value, n - 1, 0)
        if ch == 47 or ch == 92
            return str.slice(value, 0, n - 1)
    value

// Parse a `user-dirs.dirs` file into key-value pairs, with `$HOME`
// expanded and the quotes removed.
//
// `[]` — the file's text goes in, the pairs come out, and this is
// where the format's quirks are tested.  A line that is blank, a
// comment, or not `KEY="value"` is SKIPPED rather than refused: the
// file is generated by a desktop environment and a strict parser that
// refused one would leave a person with no Documents directory
// because a future version of the generator added a field.
//
// ```novo
// use dfuser
//
// fn main() [io]
//     let text = "XDG_DOCUMENTS_DIR=\"\$HOME/Documents\"\n"
//     println("${dfuser.parse_user_dirs(text, "/home/ada").len()}")
// ```
pub fn parse_user_dirs(text: Str, home: Str) -> [(Str, Str)] []
    var out: [(Str, Str)] = []
    for raw in str.split_lines(text)
        let line = str.trim(raw)
        if line == "" or str.starts_with(line, "#")
            continue
        let at = str.index(line, "=") ?? -1
        if at > 0
            let key = str.trim(str.slice(line, 0, at))
            let rest = str.slice(line, at + 1, str.len(line))
            if key != "" and str.len(rest) >= 2 and str.starts_with(rest, "\"") and str.ends_with(rest, "\"")
                let value = str.slice(rest, 1, str.len(rest) - 1)
                out = list.push(out, (key, without_trailing(expand_home(value, home))))
    out

// The directory a parsed `user-dirs.dirs` names for a role, or `""`
// when it names none.
//
// `[]`, taking the pairs the caller already read, so that a program
// asking for six directories reads the file once.
//
// ```novo
// use dfuser
// use dfenv
//
// fn main() [io]
//     let e = dfenv.bare(DfLinux, "/home/ada")
//     println(dfuser.user_dir_from(e, [], DfDocuments))
// ```
pub fn user_dir_from(e: dfenv.DfEnv, entries: [(Str, Str)], d: DfUserDir) -> Str []
    let key = xdg_key(d)
    if key != ""
        for pair in entries
            if pair.0 == key and pair.1 != ""
                return pair.1
    default_user_dir(e, d)

// The base directory joined with a relative suffix, or `""`.
//
// A join onto a base that is not there answers the suffix alone, and a
// font directory called `fonts` relative to nothing is the defect this
// whole package exists to avoid.
fn under(p: dfplat.DfPlatform, base: Str, suffix: Str) -> Str
    if base == ""
        return ""
    dfplat.join(p, base, suffix)

// The first entry of `font_dirs`: where this user's own fonts go.
//
// macOS puts them under Library, Windows under the local application
// data, and the XDG column under the data directory.
fn user_font_dir(e: dfenv.DfEnv) -> Str
    let p = dfenv.platform(e)
    if p == DfMacos
        return under(p, dfenv.home(e), "Library/Fonts")
    if p == DfWindows
        return under(p, dfbase.base_dir(e, DfDataLocal), "Microsoft/Windows/Fonts")
    under(p, dfbase.base_dir(e, DfData), "fonts")

// The font directories that belong to the machine rather than to the
// user.
//
// The Windows entry is the conventional location, written out because
// no variable this package reads names the system root.
fn system_font_dirs(e: dfenv.DfEnv) -> [Str]
    let p = dfenv.platform(e)
    if p == DfMacos
        return ["/Library/Fonts"]
    if p == DfWindows
        return ["C:\\Windows\\Fonts"]
    var out: [Str] = []
    let historical = under(p, dfenv.home(e), ".fonts")
    if historical != ""
        out = list.push(out, historical)
    out

// The English name of a user directory under the home directory.
//
// The same three names on every platform on purpose: macOS does not
// localise the path, and Windows stores a localised one in the
// registry rather than in the file it is named after.
fn default_component(d: DfUserDir) -> Str
    match d
        DfDesktop     => "Desktop"
        DfDocuments   => "Documents"
        DfDownload    => "Downloads"
        DfMusic       => "Music"
        DfPictures    => "Pictures"
        DfVideos      => "Videos"
        DfPublicShare => "Public"
        DfTemplates   => "Templates"
        // cov: skip — a font directory is answered before this table is read; the arm is here so the match covers every role
        DfFonts       => ""

// The platform's default for a user directory, with no file read:
// `~/Documents`, `~/Downloads`, and so on.
//
// What `user_dir_from` falls back to, and the whole answer on macOS
// and Windows.  `[]`.
//
// ```novo
// use dfuser
// use dfenv
//
// fn main() [io]
//     println(dfuser.default_user_dir(dfenv.bare(DfMacos, "/Users/ada"), DfPictures))
// ```
pub fn default_user_dir(e: dfenv.DfEnv, d: DfUserDir) -> Str []
    if dfenv.home(e) == ""
        return ""
    if d == DfFonts
        return user_font_dir(e)
    under(dfenv.platform(e), dfenv.home(e), default_component(d))

// The person's directory for a role, reading `user-dirs.dirs` on
// Linux.
//
// `[fs]` — one file read, and the platform's default when the file is
// absent, unreadable, or carries no entry for this role.  Never fails:
// a missing file is the ordinary case on a machine with no desktop
// environment installed.
//
// ```novo
// use dfuser
// use dfenv
//
// fn main() [io, fs]
//     println(dfuser.user_dir(dfenv.capture(), DfDownload))
// ```
pub fn user_dir(e: dfenv.DfEnv, d: DfUserDir) -> Str [fs]
    user_dir_from(e, read_user_dirs(e), d)

// Every user directory paired with its path, reading `user-dirs.dirs`
// ONCE.
//
// The call to make when more than one is wanted; six calls to
// `user_dir` open the file six times.
//
// ```novo
// use dfuser
// use dfenv
//
// fn main() [io, fs]
//     println("${dfuser.all_user_dirs(dfenv.capture()).len()}")
// ```
pub fn all_user_dirs(e: dfenv.DfEnv) -> [(DfUserDir, Str)] [fs]
    let entries = read_user_dirs(e)
    [(d, user_dir_from(e, entries, d)) for d in user_dirs()]

// Read and parse `user-dirs.dirs`, or an empty list when there is
// none.
//
// Public so that a program wanting both the pairs and the defaults can
// read once and call `user_dir_from` for each role.
//
// ```novo
// use dfuser
// use dfenv
//
// fn main() [io, fs]
//     println("${dfuser.read_user_dirs(dfenv.capture()).len()}")
// ```
pub fn read_user_dirs(e: dfenv.DfEnv) -> [(Str, Str)] [fs]
    let where = user_dirs_path(e)
    if where == ""
        return []
    parse_user_dirs(fs.read(where) ?? "", dfenv.home(e))

// Every directory fonts are installed in for this user, in precedence
// order, the per-user ones first.
//
// A list rather than a path because every platform has more than one:
// `~/.local/share/fonts` and `~/.fonts` on Linux, `~/Library/Fonts`
// and `/Library/Fonts` on macOS, `%LOCALAPPDATA%/Microsoft/Windows/Fonts`
// and the system directory on Windows.  font-nv's consumer wants all
// of them; an installer wants the first.
//
// ```novo
// use dfuser
// use dfenv
//
// fn main() [io]
//     for d in dfuser.font_dirs(dfenv.capture())
//         println(d)
// ```
pub fn font_dirs(e: dfenv.DfEnv) -> [Str] []
    var out: [Str] = []
    let user = user_font_dir(e)
    if user != ""
        out = list.push(out, user)
    list.append(out, system_font_dirs(e))
    out
